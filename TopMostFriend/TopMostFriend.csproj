<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TopMostFriend</AssemblyName>
    <RootNamespace>TopMostFriend</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>TopMostFriend.ico</ApplicationIcon>
    <Version>2.2.0</Version>
    <AssemblyVersion>2.2.0.0</AssemblyVersion>
    <FileVersion>2.2.0.0</FileVersion>
    <Authors>flashwave; compatibility hardening by project maintainer</Authors>
    <Company>flashwave</Company>
    <Product>TopMostFriend</Product>
    <Description>Always-on-top utility for Windows 10 and Windows 11.</Description>
    <RepositoryUrl>https://github.com/flashwave/topmostfriend</RepositoryUrl>
    <Platforms>AnyCPU;x64;x86</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Languages\*.xml" />
    <None Remove="Sounds\tmf_off.wav" />
    <None Remove="Sounds\tmf_on.wav" />
    <EmbeddedResource Include="TopMostFriend.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Sounds\tmf_on.wav" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Sounds\tmf_off.wav" />
  </ItemGroup>
</Project>
